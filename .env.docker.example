# pgAdmin
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123

# WebSocket runtime
# Comma-separated browser origins. Native/mobile clients without Origin remain allowed.
SECRET=replace-with-a-long-random-secret
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Time available for an authenticated client to emit `resume` after reconnecting.
SOCKET_DISCONNECT_GRACE_MS=10000
JWT_EXPIRES_IN=1d
