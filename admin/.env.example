# Même base que l'API. Idéalement un rôle Postgres dédié (voir README).
DATABASE_URL=postgresql://user:password@host:5432/railway
# "require" pour Railway / Supabase, "disable" pour un Postgres local.
DATABASE_SSL=require

ADMIN_EMAIL=admin@example.com
# npm run hash-password -- 'ton-mot-de-passe'
ADMIN_PASSWORD_HASH=
# openssl rand -base64 48  (32 caractères minimum)
ADMIN_SESSION_SECRET=
